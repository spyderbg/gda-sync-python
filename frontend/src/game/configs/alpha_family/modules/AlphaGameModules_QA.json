    },
    {
      "name": "GraphicsInspector",
      "space": "Egt::Integration",
      "header": "Egt/GraphicsInspector/GraphicsInspector.h"
    },
    {
      "name": "ScreenshotsManager",
      "space": "Egt::Integration",
      "header": "Egt/ScreenshotsManager/ScreenshotsManager.h"
    },
    {
      "name": "QaBridge",
      "space": "Egt::Integration",
      "header": "Egt/QaBridge/QaBridge.h",
      "config": {
        "enabled": true,
        "port": 5111,
        "game": "{{GAME_NAME}}"
      }
    }
